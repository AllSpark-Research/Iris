# Copy to .env and fill in. Every variable the harness reads is listed here;
# the commented ones are optional tuning knobs shown with their defaults.

# ── Model under evaluation ──────────────────────────────────────────────────
# The endpoint serving the agent policy. conf/llm/*.yaml reads this, and
# --base-url on scripts/run_eval.sh overrides it.
SGLANG_BASE_URL=http://127.0.0.1:21234/v1
# MODEL_NAME=                   # only for llm=openai-compatible; the served model name

# ── Tools ───────────────────────────────────────────────────────────────────
# Serper — Google SERP + page scrape. Required by every agent config.
SERPER_API_KEY=your_serper_key
# SERPER_BASE_URL=https://google.serper.dev
# SERPER_SCRAPE_URL=https://scrape.serper.dev
# SERPER_SEARCH_LIMIT=10        # organic results per web_search call
# SERPER_DEFAULT_GL=us          # SERP country
# SERPER_DEFAULT_HL=en          # SERP language

# Jina Reader — only for conf/agent/serper_jina_search_agent.yaml
# JINA_API_KEY=your_jina_key
# JINA_BASE_URL=https://r.jina.ai
# JINA_ENGINE=direct            # 'direct' beats 'browser' on article pages
# JINA_FALLBACK_ENGINE=browser  # escalation for genuine JS SPAs
# JINA_PROXY=                   # proxy for jina.ai traffic only; empty = direct
# JINA_THIN_CONTENT_CHARS=1200  # below this, escalate to the fallback engine
# JINA_MIN_USABLE_CHARS=200     # below this, return the body verbatim
# JINA_NO_CACHE=false           # bypass Jina's cache (it can serve poisoned entries)
# JINA_RETAIN_IMAGES=none       # none | all
# JINA_WITH_IMAGES_SUMMARY=false
# JINA_CONNECT_TIMEOUT=20
# JINA_READ_TIMEOUT=90
# JINA_PYTHON_FALLBACK=true     # retry a failed fetch with a plain httpx GET

# Zhipu — only for conf/agent/serper_zhipu_search_agent.yaml
# ZHIPU_AI_KEY=your_zhipu_key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Scrape summarizer ───────────────────────────────────────────────────────
# scrape_website returns an LLM-condensed view of the page against the caller's
# `info_to_extract`, not raw markdown. This is the model that condenses it.
SUMMARY_LLM_BASE_URL=http://127.0.0.1:8000/v1/chat/completions
SUMMARY_LLM_MODEL_NAME=your_summary_model
SUMMARY_LLM_API_KEY=your_summary_key
# SUMMARY_LLM_PROVIDER=         # openai (default) | gemini | azure | maas
# SUMMARY_LLM_API_VERSION=      # set for an Azure-style proxy
#   "maas" is for gateways that route by URL path and take model="" in the body.
# MAX_SCRAPE_CHARS=409600       # page truncation before summarization

# ── LLM-as-judge ────────────────────────────────────────────────────────────
# Grades the final answer against the ground truth. Falls back to OPENAI_* when
# the JUDGE_* variables are unset.
JUDGE_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_MODEL_NAME=your_judge_model
JUDGE_API_KEY=your_judge_key
# JUDGE_PROVIDER=               # openai (default) | gemini | azure | maas
# JUDGE_API_VERSION=            # set to use an Azure-style proxy
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Execution ───────────────────────────────────────────────────────────────
# BENCHMARK_STAGGER_SECONDS=1.0 # ramp-up delay per worker, eases the API burst
# MIROFLOW_CONV_LOG_CHECK=0     # 1 = assert the append-only log replays to the
#                               #     visible history on every turn (slow; for
#                               #     debugging context management)
# DEMO_MODE=0                   # 1 = extra stdout for interactive poking
